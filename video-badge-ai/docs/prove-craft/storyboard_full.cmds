insert.picture={"path": "C:/Users/franc/progetto-p-Iva/video-badge-ai/storyboard/panels/prova.png", "rect": [24, 40, 620, 349]}
insert.textBox={"rect": [664, 40, 272, 460], "text": "2. Scena: buongiorno  (6.2 s)\nPersone, pacchi… e da qualche tempo, anche le intelligenze artificiali.\nRecitazione: ironico\nInquadratura: Primo piano badge, sguardo in camera; poi panoramica sulla stanza\nSuono: Pacchi che strisciano, 'ding' digitale leggero"}
