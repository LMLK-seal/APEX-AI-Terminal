insert.textBox={"rect": [664, 40, 272, 460], "text": "12. Scena: riavvolgi  (1.0 s)\nRiavvolgiamo.\nRecitazione: deciso\nInquadratura: Effetto rewind: stessa inquadratura dell'apertura scorre indietro\nSuono: Nastro che si riavvolge, whoosh inverso"}
